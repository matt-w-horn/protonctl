    },
    "description": "Read a whole email conversation, oldest first, about 30,000 characters of message text per page; while `nextPageToken` is not null, call again with it for later messages. Copies of one message merge (`copies`), quoted replies are removed from each body (`quotedLinesRemoved` counts the lines; `raw: true` keeps them), and each body is then cut at 8,000 characters. Takes a threadId from `search_threads` or `get_message`.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "pageToken": {
          "description": "The nextPageToken from a previous call for the same thread.",
          "type": [
            "string",
            "null"
          ]
        },
        "raw": {
          "default": false,
          "description": "Keep quoted text in bodies and return Authentication-Results headers verbatim. Default false.",
          "type": "boolean"
        },
        "threadId": {
          "description": "A threadId from `search_threads` or `get_message`.",
          "type": "string"
        }
      },
      "required": [
        "threadId"
      ],
      "type": "object"
    },
    "meta": null,
    "name": "get_thread"
  },
