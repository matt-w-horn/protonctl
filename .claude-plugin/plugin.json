{
  "name": "protonctl",
  "displayName": "protonctl",
  "version": "0.1.0",
  "description": "A local, read-only MCP server for Proton Mail, Proton Calendar and Proton Drive, reading through Proton's own apps on your Mac. Unofficial: not affiliated with, endorsed or sponsored by Proton AG.",
  "author": {
    "name": "Matt Horn",
    "url": "https://github.com/matt-w-horn"
  },
  "repository": "https://github.com/matt-w-horn/protonctl",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "proton-mail",
    "proton-calendar",
    "proton-drive",
    "email",
    "calendar",
    "files",
    "read-only",
    "privacy",
    "macos"
  ],
  "documentationUrl": "https://github.com/matt-w-horn/protonctl#readme",
  "supportUrl": "https://github.com/matt-w-horn/protonctl/blob/main/SECURITY.md",
  "privacyPolicyUrl": "https://github.com/matt-w-horn/protonctl/blob/main/PRIVACY.md",
  "mcpServers": {
    "proton": {
      "type": "stdio",
      "command": "${CLAUDE_PLUGIN_ROOT}/scripts/serve"
    }
  }
}
